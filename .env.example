# 应用配置
NEXT_PUBLIC_APP_NAME=GPUCloud
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API 配置 (开发模式: 直连后端)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# WebSocket URL (留空则运行时按当前页面 origin 自动拼 ws(s)://host + API_URL 去掉 /api/v1 的前缀)
NEXT_PUBLIC_WS_URL=

# ---- Nginx 统一入口模式（推荐生产用法）----
# 前端和后端都经 Nginx 同源代理：API_URL 用【相对路径】，请求自动跟随当前 origin，
# 这样无论用 IP 还是域名访问都无跨域；WS_URL 留空即按当前 origin 自动拼 ws(s)://host/gpucloudapi
# NEXT_PUBLIC_APP_URL=http://your-domain.com
# NEXT_PUBLIC_API_URL=/gpucloudapi/api/v1
# NEXT_PUBLIC_WS_URL=
